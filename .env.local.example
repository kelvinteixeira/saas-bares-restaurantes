# Copie este arquivo para .env.local e preencha. O .env.local NÃO vai para o git.
# Valores em: painel do Supabase > Project Settings > API (e > Database para a senha).

# URL do projeto, ex.: https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon / publishable). Pode ir para o navegador; quem protege os dados são as regras RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta (service_role / secret). Só no servidor. Nunca com prefixo NEXT_PUBLIC_, nunca no chat.
SUPABASE_SERVICE_ROLE_KEY=
